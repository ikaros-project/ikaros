<group name="WebUIPolarPlotWidgetDemo" description="Polar Plot labels, series, grids, directions, and range examples" start="true">
    <module
        class="Constant"
        name="DirectionalSensors"
        _x="24"
        _y="24"
        data="0.95, 0.72, 0.45, 0.28, 0.38, 0.58, 0.82, 0.66"
    />

    <module
        class="Constant"
        name="Profiles"
        _x="24"
        _y="144"
        data="0.85, 0.65, 0.42, 0.30, 0.48, 0.72; 0.35, 0.52, 0.88, 0.76, 0.40, 0.25"
    />

    <module
        class="Constant"
        name="SourceLabeledValues"
        _x="24"
        _y="264"
        data="12, 18, 9, 24, 15"
    />

    <module
        class="Constant"
        name="AxisLabels"
        _x="24"
        _y="384"
        data="10, 20, 30, 40, 50"
    />

    <widget
        name="ExplicitLabels"
        class="polar-plot"
        source="DirectionalSensors.OUTPUT"
        labels="Front,Front right,Right,Back right,Back,Back left,Left,Front left"
        _x="360"
        _y="24"
        width="360"
        height="300"
        title="Explicit labels · polygon grid"
        show_title="yes"
        show_frame="yes"
        value_min="0"
        value_max="1"
        auto_range="no"
        radial_ticks="5"
        show_scale="yes"
        angle_offset="-90"
        direction="clockwise"
        grid_shape="polygon"
        show_spokes="yes"
        stroke_color="#277da1"
        fill_color="#90e0ef"
        fill_opacity="0.30"
        line_width="2"
        show_points="yes"
        point_size="3"
    />

    <widget
        name="MultipleSeries"
        class="polar-plot"
        source="Profiles.OUTPUT"
        labels="Vision,Touch,Hearing,Smell,Taste,Balance"
        _x="760"
        _y="24"
        width="360"
        height="300"
        title="Two series · circular grid"
        show_title="yes"
        show_frame="yes"
        value_min="0"
        value_max="1"
        auto_range="no"
        radial_ticks="4"
        show_scale="no"
        angle_offset="-90"
        direction="clockwise"
        grid_shape="circle"
        show_spokes="yes"
        stroke_color="#1d3557,#e63946"
        fill_color="#457b9d,#f4a261"
        fill_opacity="0.22"
        line_width="2"
        show_points="yes"
        point_size="3"
    />

    <widget
        name="SourceLabels"
        class="polar-plot"
        source="SourceLabeledValues.OUTPUT"
        label_source="AxisLabels.OUTPUT"
        labels="These,explicit,labels,are,lower priority"
        _x="360"
        _y="360"
        width="360"
        height="300"
        title="Labels from source · automatic range"
        show_title="yes"
        show_frame="yes"
        auto_range="yes"
        include_zero="yes"
        radial_ticks="4"
        show_scale="yes"
        scale_decimals="0"
        angle_offset="-90"
        direction="clockwise"
        grid_shape="polygon"
        show_spokes="yes"
        stroke_color="#6a4c93"
        fill_color="#cdb4db"
        fill_opacity="0.35"
        line_width="2"
        show_points="yes"
        point_size="4"
    />

    <widget
        name="CounterclockwiseOffset"
        class="polar-plot"
        source="DirectionalSensors.OUTPUT"
        labels="N,NE,E,SE,S,SW,W,NW"
        _x="760"
        _y="360"
        width="360"
        height="300"
        title="Counterclockwise · 0° offset"
        show_title="yes"
        show_frame="yes"
        value_min="0"
        value_max="1"
        auto_range="no"
        clamp_values="yes"
        radial_ticks="3"
        show_scale="no"
        angle_offset="0"
        direction="counterclockwise"
        grid_shape="circle"
        show_spokes="no"
        label_offset="14"
        stroke_color="#2a9d8f"
        fill_color="#a7c957"
        fill_opacity="0.28"
        line_width="3"
        line_join="round"
        show_points="no"
    />
</group>
