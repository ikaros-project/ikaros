<group name="HeatMapDemo" start="true">
    <module class="Oscillator" name="Field" frequency="0.021,0.027,0.033,0.039,0.045,0.051,0.057,0.063;0.025,0.031,0.037,0.043,0.049,0.055,0.061,0.067;0.029,0.035,0.041,0.047,0.053,0.059,0.065,0.071;0.033,0.039,0.045,0.051,0.057,0.063,0.069,0.075;0.037,0.043,0.049,0.055,0.061,0.067,0.073,0.079;0.041,0.047,0.053,0.059,0.065,0.071,0.077,0.083;0.045,0.051,0.057,0.063,0.069,0.075,0.081,0.087;0.049,0.055,0.061,0.067,0.073,0.079,0.085,0.091" type="sin" _x="24" _y="24" />

    <widget name="AutoFire" class="heat-map" source="Field.OUTPUT" auto_range="yes" include_zero="yes"
            color_map="fire" show_color_legend="yes" color_legend_ticks="5" scale_visibility="no"
            stroke_color="transparent" line_width="0" width="500" height="360" _x="380" _y="24"
            show_title="yes" show_frame="yes" title="Automatic range · fire" />

    <widget name="FixedSpectrum" class="heat-map" source="Field.OUTPUT" value_min="-1" value_max="1"
            color_map="spectrum" show_color_legend="yes" color_legend_ticks="5" scale_visibility="yes"
            stroke_color="#ffffff" line_width="1" width="500" height="360" _x="900" _y="24"
            show_title="yes" show_frame="yes" title="Fixed range · spectrum · scales" />

    <widget name="LabeledGray" class="heat-map" source="Field.OUTPUT" value_min="-1" value_max="1"
            color_map="gray" show_color_legend="no" scale_visibility="no" shape="circle" size="0.82"
            labels="Band A,Band B,Band C,Band D,Band E,Band F,Band G,Band H" label_width="72"
            stroke_color="#59636e" line_width="1" width="500" height="360" _x="380" _y="404"
            show_title="yes" show_frame="yes" title="Row labels · circles · no legend" />

    <widget name="CustomTranspose" class="heat-map" source="Field.OUTPUT" order="col" auto_range="yes"
            color_map="custom" color_map_colors="#172554,#1d4ed8,#38bdf8,#fef08a,#f97316,#991b1b"
            show_color_legend="yes" color_legend_ticks="4" color_legend_decimals="2" scale_visibility="invisible"
            stroke_color="transparent" line_width="0" width="500" height="360" _x="900" _y="404"
            show_title="yes" show_frame="yes" title="Transposed · custom colors · invisible scales" />
</group>
