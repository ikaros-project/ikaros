    <widget
        name="PackedRelative"
        class="vector-field"
        source="PackedField.OUTPUT"
        _x="360"
        _y="24"
        width="360"
        height="300"
        title="Packed [2,H,W] · relative · centered"
        show_title="yes"
        show_frame="yes"
        length_mode="relative"
        vector_scale="0.7"
        anchor="center"
        stroke_color="#244f86"
        line_width="2"
        origin_marker="circle"
        origin_marker_size="2"
        color_mode="fixed"
        scale_visibility="no"
    />

    <widget
        name="SeparateNormalized"
        class="vector-field"
        x_source="HorizontalField.OUTPUT"
        y_source="VerticalField.OUTPUT"
