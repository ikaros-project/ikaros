        _y="24"
        width="360"
        height="300"
        title="Separate X/Y · normalized · start anchored"
        show_title="yes"
        show_frame="yes"
        length_mode="normalized"
        vector_scale="0.55"
        anchor="start"
        stroke_color="#8c2f39"
        line_width="2"
        origin_marker="dot"
        origin_marker_size="2"
        color_mode="fixed"
        scale_visibility="no"
    />

    <widget
        name="MagnitudeLegend"
        class="vector-field"
        source="PackedField.OUTPUT"
        _x="360"
        _y="360"
        width="360"
        height="300"
        title="Magnitude color · automatic range · legend"
        show_title="yes"
        show_frame="yes"
        length_mode="relative"
        vector_scale="0.65"
        anchor="center"
        line_width="2"
        color_mode="magnitude"
        color_map="spectrum"
        auto_range="yes"
        show_color_legend="yes"
        color_legend_width="16"
        color_legend_ticks="5"
        color_legend_decimals="2"
        scale_visibility="no"
    />

    <widget
        name="SourceColorLegend"
        class="vector-field"
        x_source="HorizontalField.OUTPUT"
        y_source="VerticalField.OUTPUT"
        color_source="ColorValues.OUTPUT"
        _x="760"
        _y="360"
        width="360"
        height="300"
        title="Scalar color source · custom map · stride 2"
        show_title="yes"
        show_frame="yes"
        length_mode="coordinate"
        vector_scale="0.16"
        anchor="center"
        stride="2"
        line_width="3"
        color_mode="source"
        color_map="custom"
        color_map_colors="#313695,#74add1,#ffffbf,#f46d43,#a50026"
        value_min="0"
        value_max="1"
        auto_range="no"
        show_color_legend="yes"
        color_legend_width="16"
        color_legend_ticks="6"
        color_legend_decimals="1"
        x_min="0"
        x_max="1"
        y_min="0"
        y_max="1"
        scale_visibility="yes"
    />
