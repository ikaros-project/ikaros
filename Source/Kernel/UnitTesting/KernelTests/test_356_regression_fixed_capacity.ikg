<group internal="true"
    name="TestRegressionFixedCapacity"
    description="Keep RegressionStatistics capacity fixed after startup"
    start="true"
    stop="-1"
    tick_duration="0.001"
    webui_port="8353"
    http_start_delay="0.05"
    http_requests="control/TestRegressionFixedCapacity.Verifier.stage?value=1||sleep:0.03||control/TestRegressionFixedCapacity.Regression.max_samples?value=1||control/TestRegressionFixedCapacity.Verifier.stage?value=2||sleep:0.03||control/TestRegressionFixedCapacity.Regression.max_samples?value=5||sleep:0.03||control/TestRegressionFixedCapacity.Verifier.stage?value=3||sleep:0.03"
    http_terminate_after_requests="true"
    check_sum="1381"
    expected_output_contains="REGRESSION CAPACITY TEST OK"
    expected_output_once="RegressionStatistics max_samples is fixed after startup; using the startup capacity. (TestRegressionFixedCapacity.Regression)">

    <module class="Constant" name="X" data="1" />
    <module class="Constant" name="Y" data="2" />
    <module class="RegressionStatistics" name="Regression"
            max_samples="3" />
    <module class="RegressionCapacityTestModule" name="Verifier" />

    <connection source="X.OUTPUT" target="Regression.X" delay="0" />
    <connection source="Y.OUTPUT" target="Regression.Y" delay="0" />
    <connection source="Regression.SCATTER_X"
                target="Verifier.SCATTER_X" delay="0" />
    <connection source="Regression.SAMPLE_COUNT"
                target="Verifier.SAMPLE_COUNT" delay="0" />

</group>
