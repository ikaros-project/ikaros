<group internal="true"
       name="TestOutputFileSequence"
       description="OutputFile applies # numbering, fixed decimals, escaped labels, continuous tick stamps, and rising-edge file changes"
       start="true"
       stop="3"
       check_sum="93971"
       expected_file_exists="UserData/test_299_output_00.csv||UserData/test_299_output_01.csv"
       expected_file_contains="T/1,&quot;value,quoted:0&quot;,&quot;value,quoted:1&quot;||1,1.23,-2.50||2,1.23,-2.50||3,1.23,-2.50"
       cleanup_expected_files="true">
    <module name="Data" class="Constant" data="1.23456,-2.5" />
    <module name="NewFile" class="Constant" data="1" />
    <module name="Output"
            class="OutputFile"
            filename="test_299_output_##.csv"
            format="csv"
            decimals="2"
            timestamp="tick" />

    <connection delay="0"
                source="Data.OUTPUT"
                target="Output.INPUT"
                label="value,quoted" />
    <connection delay="1"
                source="NewFile.OUTPUT"
                target="Output.NEWFILE" />
</group>
