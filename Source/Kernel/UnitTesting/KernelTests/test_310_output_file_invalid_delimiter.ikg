<group internal="true"
       name="TestOutputFileInvalidDelimiter"
       description="OutputFile rejects delimiters containing multiple characters"
       start="true"
       stop="1"
       expected_exit="1"
       expected_output_contains="delimiter must be exactly one character">
    <module name="Data" class="Constant" data="1" />
    <module name="Output"
            class="OutputFile"
            filename="test_310_output_file_invalid_delimiter.txt"
            delimiter="::" />

    <connection source="Data.OUTPUT" target="Output.INPUT" label="value" />
</group>
