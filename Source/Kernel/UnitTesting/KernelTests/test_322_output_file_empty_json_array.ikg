<group internal="true"
       name="TestOutputFileEmptyJSONArray"
       description="OutputFile closes an empty JSON recording as an empty array"
       start="true"
       stop="1"
       check_sum="150366"
       expected_file_exists="UserData/test_322_output_file_empty_json_array.json"
       expected_file_contains="[]"
       cleanup_expected_files="true">
    <module name="Data" class="Constant" data="1" />
    <module name="WriteOff" class="Constant" data="0" />
    <module name="Output"
            class="OutputFile"
            filename="test_322_output_file_empty_json_array.json"
            format="json"
            timestamp="none" />

    <connection delay="0"
                source="Data.OUTPUT"
                target="Output.INPUT"
                label="value" />
    <connection delay="0"
                source="WriteOff.OUTPUT"
                target="Output.WRITE" />
</group>
