<group internal="true"
       name="TestOutputFileInvalidTimestamp"
       description="OutputFile rejects unknown timestamp modes"
       start="true"
       stop="1"
       expected_exit="1"
       expected_output_contains="OutputFile timestamp must be &quot;none&quot;, &quot;line&quot;, &quot;tick&quot;, &quot;time&quot;, or &quot;real_time&quot;">
    <module name="Data" class="Constant" data="1" />
    <module name="Output"
            class="OutputFile"
            filename="test_304_output_file_invalid_timestamp.csv"
            timestamp="utc" />

    <connection source="Data.OUTPUT" target="Output.INPUT" />
</group>
