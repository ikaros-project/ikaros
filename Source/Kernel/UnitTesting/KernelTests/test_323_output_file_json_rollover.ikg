<group internal="true"
       name="TestOutputFileJSONRollover"
       description="OutputFile closes JSON arrays during numbered-file rollover"
       start="true"
       stop="3"
       check_sum="189425"
       expected_file_exists="UserData/test_323_output_file_json_00.json||UserData/test_323_output_file_json_01.json"
       expected_file_contains="{&quot;tick&quot;:1,&quot;value&quot;:[1]}&#10;]||{&quot;tick&quot;:2,&quot;value&quot;:[1]},&#10;{&quot;tick&quot;:3,&quot;value&quot;:[1]}&#10;]"
       cleanup_expected_files="true">
    <module name="Data" class="Constant" data="1" />
    <module name="NewFile" class="Constant" data="1" />
    <module name="Output"
            class="OutputFile"
            filename="test_323_output_file_json_##.json"
            format="json"
            timestamp="tick"
            number_format="full" />

    <connection delay="0"
                source="Data.OUTPUT"
                target="Output.INPUT"
                label="value" />
    <connection delay="1"
                source="NewFile.OUTPUT"
                target="Output.NEWFILE" />
</group>
