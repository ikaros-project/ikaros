<group internal="true"
       name="TestOutputFileJSONLReservedLabel"
       description="OutputFile JSONL reserves every timestamp field name"
       start="true"
       stop="0"
       expected_exit="1"
       expected_output_contains="OutputFile JSONL connection label &quot;tick&quot; is reserved">
    <module name="Data" class="Constant" data="1" />
    <module name="Output"
            class="OutputFile"
            filename="test_318_output_file_jsonl_reserved_label.jsonl"
            format="jsonl"
            timestamp="none" />

    <connection delay="0"
                source="Data.OUTPUT"
                target="Output.INPUT"
                label="tick" />
</group>
