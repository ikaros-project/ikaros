<group internal="true"
       name="TestOutputFileJSONLNonfinite"
       description="OutputFile JSONL writes non-finite matrix values as null"
       start="true"
       stop="1"
       check_sum="135219"
       expected_file_exists="UserData/test_319_output_file_jsonl_nonfinite.jsonl"
       expected_file_contains="{&quot;values&quot;:[null,null,null]}"
       cleanup_expected_files="true">
    <module name="Data" class="Constant" data="nan,inf,-inf" />
    <module name="Output"
            class="OutputFile"
            filename="test_319_output_file_jsonl_nonfinite.jsonl"
            format="jsonl"
            timestamp="none"
            number_format="full" />

    <connection delay="0"
                source="Data.OUTPUT"
                target="Output.INPUT"
                label="values" />
</group>
