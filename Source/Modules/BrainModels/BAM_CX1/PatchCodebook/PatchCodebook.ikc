<class name="PatchCodebook" description="Shared competitive patch prototypes with local learning and soft coding">
    <parameter name="fields" type="number" default="1" />
    <parameter name="height" type="number" default="8" />
    <parameter name="width" type="number" default="8" />
    <parameter name="kernel_size" type="number" default="3" />
    <parameter name="code_count" type="number" default="4" />
    <parameter name="temperature" type="number" default="0.1" />
    <parameter name="learning_rate" type="number" default="0.01" />
    <parameter name="train" type="bool" default="false" />
    <parameter name="random_seed" type="number" default="1" />
    <input name="INPUT" shape="@fields,@height,@width" />
    <output name="OUTPUT" shape="@fields,@code_count,@height-@kernel_size+1,@width-@kernel_size+1" />
    <state name="PROTOTYPES" size="@code_count,@kernel_size*@kernel_size" type="matrix" persistent="true" />
    <state name="USAGE" size="@code_count" type="matrix" persistent="true" />
</class>
