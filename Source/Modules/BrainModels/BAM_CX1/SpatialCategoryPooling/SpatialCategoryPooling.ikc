<class name="SpatialCategoryPooling" description="Attention-weighted pooling from local binding to global category evidence">
    <parameter name="fields" type="number" default="3" />
    <parameter name="categories" type="number" default="2" />
    <parameter name="epsilon" type="number" default="1e-06" />
    <input name="INPUT" shape="@fields,@categories" />
    <input name="ATTENTION" shape="@fields" />
    <output name="OUTPUT" shape="1,@categories" />
</class>
