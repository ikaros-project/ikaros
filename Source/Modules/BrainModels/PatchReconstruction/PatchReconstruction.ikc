<class name="PatchReconstruction" description="Linear code-to-patch decoding with uniform overlap averaging">
    <parameter name="fields" type="number" default="1" />
    <parameter name="height" type="number" default="8" />
    <parameter name="width" type="number" default="8" />
    <parameter name="kernel_size" type="number" default="3" />
    <parameter name="code_count" type="number" default="4" />
    <parameter name="clip" type="bool" default="true" />
    <input name="INPUT" shape="@fields,@code_count,@height-@kernel_size+1,@width-@kernel_size+1" />
    <output name="OUTPUT" shape="@fields,@height,@width" />
    <state name="WEIGHTS" size="@code_count,@kernel_size*@kernel_size" type="matrix" persistent="true" />
</class>
