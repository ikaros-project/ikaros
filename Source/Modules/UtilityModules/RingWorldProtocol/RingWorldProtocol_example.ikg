<group name="RingWorldProtocol_example" start="true" stop="-1" tick_duration="0.05" grid_spacing="24">
    <module class="RingWorldProtocol" name="Protocol" filename="RingWorldProtocol_example.json" max_stimuli="8" max_sampling_windows="4" _x="48" _y="48" />
    <module class="RingWorld" name="World" field_of_view="120" fixation_margin="4" retina_width="25" _x="360" _y="48" />
    <connection source="Protocol.STIMULI" target="World.STIMULI" />

    <widget name="RingWorldView" class="ringworldview"
        stimuli_source="Protocol.STIMULI"
        field_of_view_parameter="World.field_of_view" upper_half_only="yes" stimulus_radius="12"
        title="Ring world" show_title="yes" show_frame="yes"
        x="24" y="24" _x="24" _y="24" width="360" height="360" />
    <widget name="TrialState" class="plot" title="Trial state"
        source="Protocol.TRIAL_ACTIVE,Protocol.TRIAL_TIME"
        x="408" y="24" _x="408" _y="24" width="456" height="168" />
    <widget name="ProtocolTime" class="plot" title="Protocol time"
        source="Protocol.PROTOCOL_TIME"
        x="408" y="216" _x="408" _y="216" width="456" height="168" />
</group>
