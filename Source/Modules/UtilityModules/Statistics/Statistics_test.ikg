<group log_level="6" auto_routing="false" name="Statistics_test" tick_duration="1" grid_spacing="24">
   <parameter value="6" options="inherit,quiet,exception,end_of_file,terminate,fatal_error,warning,print,debug,trace" type="number" control="menu" default="0" name="log_level"/>
   <parameter value="0" options="at_tick,first_data,all_data" type="number" control="menu" default="0" name="module_start"/>
   <parameter value="0" name="start_tick" default="0" type="number"/>
   <module _x="24" name="Values" data="1, 10, 4" class="Constant" _y="72"/>
   <module _x="192" max="1" type="gaussian" stddev="12" class="Noise" _y="96" min="-1" name="Noise"/>
   <module _x="24" name="Sample" data="1, 1, 1" class="Constant" _y="216"/>
   <module _x="384" group_test="parametric" class="Statistics" labels="A,B,C&#10;" _y="144" pairwise_test="parametric" p_adjustment="holm" bins="50" module_start="all_data" name="Statistics"/>
   <widget outlier_radius="3" name="BoxPlot" y_axis_label="Value&#10;" title="Box Plot" outlier_source="Statistics.BOX_PLOT_OUTLIERS" show_title="yes" width="433" line_width="1" y_min="0" show_frame="yes" height="601" source="Statistics.BOX_PLOT" class="boxplot" style="" auto_range="yes" _y="24" _index_="0" show_x_labels="yes" orientation="vertical" horizontal_grid_lines="5" frame-style="" x_axis_label="Channel" y_max="4" _x="1560" fill_color="red, green,blue" background="" show_y_axis="yes" frame_width="1" stroke_color="&#10;" include_zero="no" left_tick_marks="5" left_scale_ticks="5" decimals="2" labels="&#10;" frame_color=""/>
   <widget include_zero="yes" frame_width="2" frame_color="black" background="#ffe&#10;&#10;" orientation="vertical" class="bar-graph" source="Statistics.MEDIAN" show_title="yes" frame-style="" y_min="0" line_cap="" fill_color="red, green, blue" style="" auto_range="yes" show_frame="yes" height="217" line_width="1" width="241" line_join="" transpose="no" _x="384" y_max="1" _y="864" _index_="2" labels="A,B,C" stroke_color="" title="MEDIAN" name="Widget_1"/>
   <widget frame_color="" height="601" show_frame="yes" auto_range="yes" style="" y_max="1" _x="648" space_right="4" transpose="no" margin_top="4" background="" bottom_scale_ticks="5" source="Statistics.HISTOGRAM" class="histogram" line_cap="" left_tick_marks="5" fill_color="#ccc" y_min="0" mean_source="Statistics.MEAN" show_x_axis="yes" select="" line_join="" width="889" include_zero="no" horizontal_grid_lines="2" standard_deviation_source="Statistics.STANDARD_DEVIATION" orientation="vertical" margin_right="4" _y="24" margin_bottom="4" curve_color="red" title="Statistics.HISTOGRAM" _index_="4" show_y_axis="yes" show_title="yes" margin_left="4" left_scale_ticks="5" space_left="4" space_top="4" frame-style="" y_axis_label="Channel&#10;" histogram_max_source="Statistics.HISTOGRAM_MAX" line_width="1" x_axis_label="Value" labels="&#10;" space_bottom="4" decimals="2" bottom_tick_marks="24" stroke_color="&#10;" frame_width="1" name="Widget_2" histogram_min_source="Statistics.HISTOGRAM_MIN"/>
   <widget name="Widget_3" label_x="&#10;" width="433" show_title="yes" title="Pairwise p-value" frame_width="1" style="" _index_="6" _y="864" max="1" _x="1560" height="121" scrollable="no" show_frame="yes" label_y="&#10;" min="0" background="" colorize="yes" select="" source="Statistics.PAIRWISE_TEST_P" class="table" decimals="4" frame_color="" frame-style="" transpose="no"/>
   <widget name="Widget_31" label_x="&#10;" width="433" show_title="yes" title="Adjusted p-value" frame_width="1" style="" _index_="8" _y="1008" max="1" _x="1560" height="145" scrollable="no" show_frame="yes" label_y="&#10;" min="0" background="" colorize="yes" select="" source="Statistics.PAIRWISE_TEST_P_ADJUSTED" class="table" decimals="4" frame_color="" frame-style="" transpose="no"/>
   <widget name="Widget_311" label_x="" width="313" show_title="yes" title="Group Test (ANOVA)" frame_width="1" style="" _index_="10" _y="648" max="1" _x="1224" height="433" scrollable="no" show_frame="yes" label_y="" min="0" background="" colorize="yes" select="" source="Statistics.GROUP_TEST" class="table" decimals="0" frame_color="" frame-style="" transpose="no"/>
   <widget name="Widget_3111" label_x="&#10;" width="433" show_title="yes" title="Box Plot Data" frame_width="1" style="" _index_="12" _y="648" max="1" _x="1560" height="193" scrollable="no" show_frame="yes" label_y=" " min="0" background="" colorize="yes" select="" source="Statistics.BOX_PLOT" class="table" decimals="4" frame_color="" frame-style="" transpose="no"/>
   <widget name="Widget_31111" label_x="&#10;" width="553" show_title="yes" title="Summary Statistics" frame_width="1" style="" _index_="14" _y="648" max="1" _x="648" height="289" scrollable="no" show_frame="yes" label_y=" " min="0" background="" colorize="yes" select="" source="Statistics.OUTPUT" class="table" decimals="4" frame_color="" frame-style="" transpose="no"/>
   <widget name="Widget_311111" label_x="&#10;" width="553" show_title="yes" title="Normality Test" frame_width="1" style="" _index_="16" _y="960" max="1" _x="648" height="289" scrollable="no" show_frame="yes" label_y=" " min="0" background="" colorize="yes" select="" source="Statistics.NORMALITY_TEST" class="table" decimals="4" frame_color="" frame-style="" transpose="no"/>
   <connection target="Noise.INPUT" source="Values.OUTPUT" line_type="auto_route"/>
   <connection target="Statistics.INPUT" source="Noise.OUTPUT" line_type="auto_route"/>
</group>
