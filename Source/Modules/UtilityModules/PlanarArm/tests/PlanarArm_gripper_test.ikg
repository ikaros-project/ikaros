<group name="PlanarArm_Gripper_Test" start="true" stop="1">
    <module name="GripperCommand" class="Constant" data="0" />
    <module name="Arm" class="PlanarArm"
        base_position="30,60"
        link_lengths="30"
        initial_joint_angles="0"
        joint_min="-1"
        joint_max="1"
        max_joint_step="0.002"
        palm_length="20"
        finger_length="20"
        link_width="2"
        gripper_width="2"
        initial_gripper="1"
        finger_open_angle="0.45"
        finger_closed_angle="0.65"
        movable_object="70,60,4"
        circle_obstacle_count="0"
        circle_obstacles=""
        line_obstacle_count="0"
        line_obstacles=""
        world_width="120"
        world_height="120" />
    <module name="PrintObject" class="Print" />
    <module name="PrintGripperContacts" class="Print" />
    <module name="PrintEnclosed" class="Print" />

    <connection source="GripperCommand.OUTPUT" target="Arm.GRIPPER" delay="0" />
    <connection source="Arm.MOVABLE_OBJECT" target="PrintObject.INPUT" delay="0" />
    <connection source="Arm.GRIPPER_CONTACTS" target="PrintGripperContacts.INPUT" delay="0" />
    <connection source="Arm.ENCLOSED" target="PrintEnclosed.INPUT" delay="0" />
</group>
