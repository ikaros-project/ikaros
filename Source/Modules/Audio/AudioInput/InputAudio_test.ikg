   <widget _index_="2" _x="360" _y="312" auto_range="yes" class="bar-graph" stroke_color="" orientation="vertical" fill_color="" frame-style="" height="200" labels="" line_cap="" line_join="" line_width="1" y_max="1" y_min="0" name="Widget_6" show_frame="no" show_title="yes" source="Scale.OUTPUT" style="" title="Widget_6" transpose="no" width="200"/>
