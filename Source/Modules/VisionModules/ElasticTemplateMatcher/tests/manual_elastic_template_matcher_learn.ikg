<group name="ElasticTemplateMatcherLearnTest" start="true" stop="5">
    <module class="InputImage" name="Image" filename="../Examples/Media/grayrobot.jpg" read_once="yes" />
    <module class="Downsample" name="Downsample" />
    <module class="Constant" name="Learn" data="1" />
    <module class="Constant" name="Clear" data="0" />
    <module class="ElasticTemplateMatcher" name="Matcher"
        learning_region="0.5"
        max_num_keypoints="256"
        detection_interval="1"
        min_matches="6"
        device="cpu"
        python_executable="../../../../.venv-aliked-lightglue/bin/python"
        timeout_ms="10000" />
    <module class="Print" name="PrintValid" />
    <module class="Print" name="PrintTemplateCount" />
    <module class="Print" name="PrintInliers" />
    <module class="Print" name="PrintCorrespondences" />

    <connection source="Image.INTENSITY" target="Downsample.INPUT" />
    <connection source="Downsample.OUTPUT" target="Matcher.INPUT" />
    <connection source="Learn.OUTPUT" target="Matcher.LEARN" />
    <connection source="Clear.OUTPUT" target="Matcher.CLEAR" />
    <connection source="Matcher.VALID" target="PrintValid.INPUT" label="VALID" />
    <connection source="Matcher.TEMPLATE_COUNT" target="PrintTemplateCount.INPUT" label="TEMPLATE_COUNT" />
    <connection source="Matcher.INLIER_COUNT" target="PrintInliers.INPUT" label="INLIER_COUNT" />
    <connection source="Matcher.CORRESPONDENCE_COUNT" target="PrintCorrespondences.INPUT" label="CORRESPONDENCE_COUNT" />
</group>
