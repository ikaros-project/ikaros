<group name="Elastic_Template_Matching_Demo" start="true">
    <module class="InputVideo" name="Camera" id="0" list_devices="no"
        size_x="640" size_y="480" frame_rate="15" _x="1240" _y="40" />
    <module class="Downsample" name="RGB320" _x="1440" _y="40" />
    <module class="Downsample" name="Gray320" _x="1440" _y="120" />
    <module class="ALIKEDFeatureExtractor" name="Features" _x="1640" _y="40" />
    <module class="TemplateFeatureBank" name="Templates" learning_region="0.5"
        _x="1840" _y="40" />
    <module class="FeaturePointBoxes" name="LearnedFeatureBoxes" box_size="5"
        _x="2040" _y="220" />
    <module class="LightGlueFeatureMatcher" name="Matcher" _x="2040" _y="40" />
    <module class="RobustTransformEstimator" name="Geometry" _x="2240" _y="40" />
    <module class="PyramidalLucasKanadeTracker" name="Tracker" _x="2240" _y="140" />
    <module class="TemplateTrackingController" name="Controller" detection_interval="10"
        _x="2440" _y="40" />
    <module class="TemplatePolygonTransform" name="Polygon" _x="2640" _y="40" />
    <module class="Or" name="DetectionRequest" _x="1840" _y="360" />
    <module class="Constant" name="LearnTrigger" data="0" _x="1640" _y="180" />
    <module class="Constant" name="ClearTrigger" data="0" _x="1640" _y="260" />
    <module class="Constant" name="LearningBox"
        data="-0.1875,-0.25,0.375,0.5" _x="1840" _y="260" />

    <connection source="Camera.OUTPUT" target="RGB320.INPUT" />
    <connection source="Camera.INTENSITY" target="Gray320.INPUT" />
    <connection source="RGB320.OUTPUT" target="Features.INPUT" />
    <connection source="Controller.MATCH_ENABLE" target="DetectionRequest.INPUT1" />
    <connection source="LearnTrigger.OUTPUT" target="DetectionRequest.INPUT2" />
    <connection source="DetectionRequest.OUTPUT" target="Features.ENABLE" />
    <connection source="Features.KEYPOINTS" target="Templates.KEYPOINTS" />
    <connection source="Features.DESCRIPTORS" target="Templates.DESCRIPTORS" />
    <connection source="Features.SCORES" target="Templates.SCORES" />
    <connection source="LearnTrigger.OUTPUT" target="Templates.LEARN" />
    <connection source="ClearTrigger.OUTPUT" target="Templates.CLEAR" />
    <connection source="Templates.TEMPLATE_KEYPOINTS" target="LearnedFeatureBoxes.POINTS" />
    <connection source="Features.KEYPOINTS" target="Matcher.KEYPOINTS" />
    <connection source="Features.DESCRIPTORS" target="Matcher.DESCRIPTORS" />
    <connection source="Templates.TEMPLATE_KEYPOINTS" target="Matcher.TEMPLATE_KEYPOINTS" />
    <connection source="Templates.TEMPLATE_DESCRIPTORS" target="Matcher.TEMPLATE_DESCRIPTORS" />
    <connection source="Templates.TEMPLATE_RANGES" target="Matcher.TEMPLATE_RANGES" />
    <connection source="DetectionRequest.OUTPUT" target="Matcher.ENABLE" />
    <connection source="Features.KEYPOINTS" target="Geometry.KEYPOINTS" />
    <connection source="Templates.TEMPLATE_KEYPOINTS" target="Geometry.TEMPLATE_KEYPOINTS" />
    <connection source="Templates.TEMPLATE_RANGES" target="Geometry.TEMPLATE_RANGES" />
    <connection source="Matcher.CORRESPONDENCES" target="Geometry.CORRESPONDENCES" />
    <connection source="Gray320.OUTPUT" target="Tracker.IMAGE" />
    <connection source="Features.KEYPOINTS" target="Tracker.KEYPOINTS" />
    <connection source="Templates.TEMPLATE_KEYPOINTS" target="Tracker.TEMPLATE_KEYPOINTS" />
    <connection source="Templates.TEMPLATE_RANGES" target="Tracker.TEMPLATE_RANGES" />
    <connection source="Geometry.HOMOGRAPHY" target="Tracker.SEED_HOMOGRAPHY" />
    <connection source="Geometry.RESULT" target="Tracker.SEED_RESULT" />
    <connection source="Geometry.INLIERS" target="Tracker.SEED_INLIERS" />
    <connection source="Geometry.HOMOGRAPHY" target="Controller.DETECTION_TRANSFORM" />
    <connection source="Geometry.RESULT" target="Controller.DETECTION_RESULT" />
    <connection source="Tracker.TRANSFORM" target="Controller.TRACKING_TRANSFORM" />
    <connection source="Tracker.RESULT" target="Controller.TRACKING_RESULT" />
    <connection source="Controller.TRANSFORM" target="Polygon.HOMOGRAPHY" />
    <connection source="Controller.RESULT" target="Polygon.RESULT" />
    <connection source="Templates.TEMPLATE_CORNERS" target="Polygon.TEMPLATE_CORNERS" />
    <connection source="Features.KEYPOINTS" target="Polygon.KEYPOINTS" />
    <connection source="Geometry.INLIERS" target="Polygon.INLIERS" />
    <connection source="Tracker.CURRENT_POINTS" target="Polygon.TRACKED_POINTS" />

    <widget class="image" name="CameraImage" _x="40" _y="40" width="800" height="600"
        source="Camera.OUTPUT" format="rgb" scale="both" show_title="no" show_frame="no" />
    <widget class="target-boxes" name="LearningRegion" _x="40" _y="40" width="800" height="600"
        source="LearningBox.OUTPUT" box_color="#ffd84d" line_width="2"
        show_score="no" show_title="no" show_frame="no" />
    <widget class="path" name="MatchedRegion" _x="40" _y="40" width="800" height="600"
        source="Polygon.PATH" order="row" select_x="0" point_count="5" close="no" arrow="no"
        line_width="4" stroke_color="#00ff66" fill_color="rgba(0,255,102,0.08)"
        x_min="-1" x_max="1" y_min="-1" y_max="1" scale_visibility="no"
        show_title="no" show_frame="no" />
    <widget class="target-boxes" name="MatchedFeatures" _x="40" _y="40" width="800" height="600"
        source="Polygon.MATCHED_FEATURES" box_color="#00c8ff" line_width="2"
        show_score="no" show_title="no" show_frame="no" />
    <widget class="target-boxes" name="LearnedFeatures" _x="40" _y="40" width="800" height="600"
        source="LearnedFeatureBoxes.BOXES" box_color="#ffd84d" line_width="1"
        show_score="no" show_title="no" show_frame="no" />
    <widget class="button" name="LearnButton" _x="880" _y="40" width="160" height="56"
        type="push" parameter="LearnTrigger.data" value="1" release_value="0" label="Learn"
        show_title="no" show_frame="yes" />
    <widget class="button" name="ClearButton" _x="880" _y="112" width="160" height="56"
        type="push" parameter="ClearTrigger.data" value="1" release_value="0" label="Clear templates"
        show_title="no" show_frame="yes" />
    <widget class="table" name="Location" _x="880" _y="200" width="280" height="100"
        source="Polygon.LOCATION" title="Location" label_x="X,Y" decimals="3"
        colorize="no" scrollable="no" transpose="no" />
    <widget class="table" name="Status" _x="880" _y="320" width="280" height="180"
        source="Controller.STATUS" title="Matcher status"
        label_x="Template,Valid,Tracking,Correspondences,Inliers,Confidence"
        decimals="3" colorize="no" scrollable="no" transpose="no" />
    <widget class="table" name="TemplateRanges" _x="880" _y="520" width="280" height="160"
        source="Templates.TEMPLATE_RANGES" title="Learned templates"
        label_x="Feature start,Feature length" decimals="0" colorize="no"
        scrollable="yes" transpose="no" />
</group>
