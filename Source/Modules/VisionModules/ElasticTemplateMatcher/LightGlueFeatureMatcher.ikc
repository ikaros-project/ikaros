<class name="LightGlueFeatureMatcher" description="Matches learned ALIKED templates to current features with native LightGlue">
    <input name="KEYPOINTS" description="Current pixel-coordinate feature rows: x,y" />
    <input name="DESCRIPTORS" description="Current 128D descriptor rows" />
    <input name="TEMPLATE_KEYPOINTS" description="Concatenated template pixel-coordinate keypoints" />
    <input name="TEMPLATE_DESCRIPTORS" description="Concatenated template descriptor rows" />
    <input name="TEMPLATE_RANGES" description="Template rows: feature start, feature length" />
    <input name="ENABLE" optional="yes" size="1" description="Run matching while positive; an unconnected input enables matching" />
    <output name="CORRESPONDENCES" dynamic="yes" capacity="@max_templates*@max_matches_per_template,4" description="Rows: template index, template feature index, current feature index, LightGlue score" />
    <parameter name="model_path" type="string" default="models/ElasticTemplateMatcher/aliked-lightglue-512.onnx" description="LightGlue ONNX model inside the project directory or UserData" />
    <parameter name="image_width" type="number" default="320" min="1" description="Feature image width in pixels" />
    <parameter name="image_height" type="number" default="240" min="1" description="Feature image height in pixels" />
    <parameter name="score_threshold" type="number" default="0.1" min="0" max="1" description="Minimum LightGlue score emitted" />
    <parameter name="max_features" type="number" default="512" min="1" max="512" description="Maximum features accepted in either set" />
    <parameter name="max_templates" type="number" default="16" min="1" description="Maximum template range rows processed" />
    <parameter name="max_matches_per_template" type="number" default="512" min="1" max="512" description="Maximum emitted matches for each template" />
</class>
