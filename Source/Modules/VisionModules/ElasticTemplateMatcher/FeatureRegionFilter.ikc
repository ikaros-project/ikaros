<class name="FeatureRegionFilter" description="Optionally restricts aligned feature matrices to a centered image region">
    <input name="KEYPOINTS" description="Pixel-coordinate keypoint rows: x,y" />
    <input name="DESCRIPTORS" description="Descriptor rows aligned with KEYPOINTS" />
    <input name="RESTRICT" size="1" description="Restrict features to the centered region when positive" />
    <output name="FILTERED_KEYPOINTS" dynamic="yes" capacity="@max_features,2" />
    <output name="FILTERED_DESCRIPTORS" dynamic="yes" capacity="@max_features,@descriptor_size" />
    <parameter name="image_width" type="number" default="320" min="1" />
    <parameter name="image_height" type="number" default="240" min="1" />
    <parameter name="region" type="number" default="0.5" min="0.05" max="1" description="Centered square side as a fraction of the shorter image side" />
    <parameter name="max_features" type="number" default="512" min="1" />
    <parameter name="descriptor_size" type="number" default="128" min="1" />
</class>
