<class name="ElasticTemplateMatcher" description="Learns and tracks visual templates with ALIKED, LightGlue, homography verification, and Lucas-Kanade flow">
    <input name="INPUT" description="Grayscale input image" />
    <input name="LEARN" description="Learn a template on a rising edge" />
    <input name="CLEAR" description="Discard all templates on a rising edge" />

    <output name="LOCATION" size="2" description="Best template center in centered image coordinates" />
    <output name="MATCH" size="1" description="Mean LightGlue confidence of verified correspondences" />
    <output name="TEMPLATE_ID" size="1" description="Zero-based best template index, or -1" />
    <output name="VALID" size="1" description="One when detection or tracking is geometrically valid" />
    <output name="TEMPLATE_COUNT" size="1" description="Number of templates learned in this run" />
    <output name="CORRESPONDENCE_COUNT" size="1" description="LightGlue correspondences for the best candidate" />
    <output name="INLIER_COUNT" size="1" description="Homography or optical-flow inliers for the best candidate" />
    <output name="TRACKING" size="1" description="One when the current result comes from Lucas-Kanade tracking" />
    <output name="LEARNING_BOX" size="1,5" description="Central learning region as x, y, width, height, score" />
    <output name="MATCH_CORNERS" size="1,8" description="Four transformed corners as x0,y0,... in centered coordinates" />
    <output name="MATCHED_FEATURES" size="@max_num_keypoints,5" description="Verified feature locations as centered-coordinate boxes" />

    <parameter name="learning_region" type="number" default="0.25" min="0.05" max="1" description="Central square side as a fraction of the smaller image dimension" />
    <parameter name="max_num_keypoints" type="number" default="512" min="32" description="Maximum ALIKED keypoints per frame" />
    <parameter name="detection_interval" type="number" default="10" min="1" description="Ticks between full ALIKED and LightGlue reacquisition passes" />
    <parameter name="min_matches" type="number" default="8" min="4" description="Minimum homography inliers" />
    <parameter name="ransac_threshold" type="number" default="3" min="0.1" description="MAGSAC reprojection threshold in pixels" />
    <parameter name="track_max_error" type="number" default="20" min="0" description="Maximum Lucas-Kanade forward error" />
    <parameter name="track_fb_error" type="number" default="1.5" min="0" description="Maximum forward-backward tracking error in pixels" />
    <parameter name="corner_smoothing" type="number" default="0.35" min="0" max="1" description="Fraction of each new corner position applied per tick" />
    <parameter name="min_area_fraction" type="number" default="0.002" min="0" max="1" description="Minimum transformed quadrilateral area relative to the image" />
    <parameter name="max_area_fraction" type="number" default="0.95" min="0" max="1" description="Maximum transformed quadrilateral area relative to the image" />
    <parameter name="device" type="string" control="menu" options="cpu,mps,auto" default="auto" description="PyTorch inference device" />
</class>
