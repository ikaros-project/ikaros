<class name="TemplatePolygonTransform" description="Projects and validates a learned template polygon">
    <input name="HOMOGRAPHY" size="3,3" description="Template-to-current projective transform" />
    <input name="RESULT" description="Verified transform result row" />
    <input name="TEMPLATE_CORNERS" description="Template corner rows" />
    <input name="KEYPOINTS" description="Current pixel-coordinate keypoints" />
    <input name="INLIERS" description="Verified correspondence rows" />
    <input name="TRACKED_POINTS" optional="yes" description="Current LK-tracked points used for feature overlays" />
    <output name="PATH" dynamic="yes" capacity="5,2" description="Closed transformed polygon in centered image coordinates" />
    <output name="LOCATION" dynamic="yes" capacity="1,2" description="Transformed polygon center in centered image coordinates" />
    <output name="MATCHED_FEATURES" dynamic="yes" capacity="@max_features,4" description="Centered target boxes around verified current features" />
    <parameter name="image_width" type="number" default="320" min="1" />
    <parameter name="image_height" type="number" default="240" min="1" />
    <parameter name="min_area_fraction" type="number" default="0.002" min="0" max="1" />
    <parameter name="max_area_fraction" type="number" default="0.9" min="0" max="1" />
    <parameter name="max_features" type="number" default="512" min="1" />
</class>
